[
  {
    "text": "A UNIAO FAZ A FORCA",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "TEMPO E DINHEIRO",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "O SABER NAO OCUPA LUGAR",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "QUEM TEM BOCA VAI A ROMA",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "QUEM NAO ARRISCA NAO PETISCA",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "A PRATICA LEVA A PERFEICAO",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "DEUS AJUDA QUEM CEDO MADRUGA",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "A PRESSA E INIMIGA DA PERFEICAO",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "QUEM SEMEIA VENTO COLHE TEMPESTADE",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "DE GRAO EM GRAO A GALINHA ENCHE O PAPO",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "MAIS VALE UM PASSARO NA MAO DO QUE DOIS VOANDO",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "AGUA MOLE EM PEDRA DURA TANTO BATE ATE QUE FURA",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "DO QUE O OLHO NAO VE O CORACAO NAO SENTE",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "QUEM COM FERRO FERE COM FERRO SERA FERIDO",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "CADA MACACO NO SEU GALHO",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "ROMA NAO FOI CONSTRUIDA EM UM DIA",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "PIOR CEGO E O QUE NAO QUER VER",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "O HABITO NAO FAZ O MONGE",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "A ESPERANCA E A ULTIMA QUE MORRE",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "QUEM ESPERA ALCANCA",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "MAIS VALE TARDE DO QUE NUNCA",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  },
  {
    "text": "NAO DEIXE PARA AMANHA O QUE PODE FAZER HOJE",
    "source": "ditado popular (domínio público)",
    "verifiedAt": "2026-10-19"
  }
]
